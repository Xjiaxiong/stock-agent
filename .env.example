# 复制这个文件为 .env，然后把 key 换成你自己的：
#   cp .env.example .env
# 项目根目录只放一份，day1/ day2/ 等所有目录共享
DEEPSEEK_API_KEY=sk-请替换成你的key

# 同花顺金融数据 API（行情/财务/新闻/涨停池/概念指数都走它）
# 每日复盘与个股研究取数都需要
HITHINK_FINANCE_API_KEY=sk-请替换成你的key

# 可选：覆盖 LLM 用量日志路径（默认 market/logs/llm-usage.jsonl）
# LLM_USAGE_LOG=./logs/llm-usage.jsonl
